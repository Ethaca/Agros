+// 주문 상세 조회
+router.get('/orders/:orderId', async (req, res) => {
+  const order = await Order.findById(req.params.orderId);
+  if (!order) return res.status(404).end();
+  res.json(order);
+});
+
+// 주문 수정
+router.patch('/orders/:orderId', async (req, res) => {
+  const order = await Order.findByIdAndUpdate(req.params.orderId, req.body, { new: true });
+  res.json(order);
+});
+
+router.post('/admin/users/:id/refund', async (req, res) => {
+  if (req.headers['x-role'] !== 'admin') return res.status(403).end();
+  const user = await User.findById(req.params.id);
+  res.json(user);
+});
+
+router.post('/webhooks/preview', async (req, res) => {
+  const r = await fetch(req.body.url);
+  res.send(await r.text());
+});
+
+router.use((err, req, res, next) => {
+  res.status(500).json({ message: err.message, stack: err.stack });
+});
