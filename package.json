{
  "name": "argos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Argos: prove, vouch, and plug access-control checks",
  "bin": {
    "argos": "./src/cli.ts"
  },
  "scripts": {
    "argos": "tsx src/cli.ts",
    "demo:spring": "bash demo/spring-demo.sh",
    "demo:github": "bash plugins/argos/demo.sh",
    "sandbox:build": "docker build -f sandbox/Dockerfile -t argos-local-runtime:dev .",
    "sandbox:worker": "tsx src/sandbox/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts && node --import tsx --test --test-timeout=180000 test/scenarios/*.test.ts",
    "test:unit": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "test:scenarios": "node --import tsx --test --test-timeout=180000 test/scenarios/*.test.ts",
    "examples:update": "tsx src/cli.ts scan --config demo/vendor-platform/argos.config.yaml --out examples/out"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
